SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_APP_URL=https://image-alt.onrender.com
SCOPES=read_products,write_products,read_files,write_files,read_content,write_content
PORT=3000
NODE_ENV=production
# Local development: file:dev.sqlite
# Render with a persistent disk: file:/var/data/dev.sqlite
DATABASE_URL=file:dev.sqlite
